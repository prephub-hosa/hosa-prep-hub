{
  "proof": {
    "reviews": {
      ".read": true,
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) || (auth != null && auth.token.email === 'tylerkim1215@gmail.com')",
        ".validate": "(!newData.exists() || newData.hasChildren(['stars', 'text', 'name', 'ts'])) && (!newData.exists() || (auth != null && auth.token.email === 'tylerkim1215@gmail.com') || (newData.child('ts').val() === now && !newData.child('approved').exists()))",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "chapter": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
        },
        "chapterSlug": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{0,44}$/)"
        },
        "public": {
          ".validate": "newData.isBoolean()"
        },
        "approved": {
          ".validate": "newData.isBoolean()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "stars": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280"
        }
      }
    },
    "results": {
      ".read": true,
      "$uid": {
        "$rid": {
          ".write": "(auth != null && auth.uid === $uid) || (auth != null && auth.token.email === 'tylerkim1215@gmail.com')",
          ".validate": "(!newData.exists() || newData.hasChildren(['level', 'event', 'place', 'year', 'name', 'ts'])) && (!newData.exists() || (auth != null && auth.token.email === 'tylerkim1215@gmail.com') || (newData.child('ts').val() === now && !newData.child('approved').exists())) && $rid.matches(/^[A-Za-z0-9_-]{1,40}$/)",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "chapter": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
          },
          "chapterSlug": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{0,44}$/)"
          },
          "public": {
            ".validate": "newData.isBoolean()"
          },
          "approved": {
            ".validate": "newData.isBoolean()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          "level": {
            ".validate": "newData.isString() && newData.val().matches(/^(regional|area|state|ilc|other)$/)"
          },
          "event": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "place": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 === 0"
          },
          "year": {
            ".validate": "newData.isNumber() && newData.val() >= 2020 && newData.val() <= 2100"
          }
        }
      }
    },
    "chapters": {
      ".read": true,
      "$slug": {
        ".write": "((auth != null && root.child('chat/' + $slug + '/owners/' + auth.uid).val() === true)) || (auth != null && auth.token.email === 'tylerkim1215@gmail.com')",
        ".validate": "(!newData.exists() || newData.hasChildren(['text', 'name', 'uid', 'ts'])) && (!newData.exists() || (auth != null && auth.token.email === 'tylerkim1215@gmail.com') || (newData.child('ts').val() === now && !newData.child('approved').exists())) && $slug.matches(/^[a-z0-9-]{1,44}$/)",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "chapter": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
        },
        "chapterSlug": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{0,44}$/)"
        },
        "public": {
          ".validate": "newData.isBoolean()"
        },
        "approved": {
          ".validate": "newData.isBoolean()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 400"
        },
        "uid": {
          ".validate": "newData.isString() && (newData.val() === auth.uid || (auth != null && auth.token.email === 'tylerkim1215@gmail.com'))"
        }
      }
    },
    "stats": {
      ".read": true,
      ".write": "(auth != null && auth.token.email === 'tylerkim1215@gmail.com')"
    },
    "snapshots": {
      ".read": "(auth != null && auth.token.email === 'tylerkim1215@gmail.com')",
      "$day": {
        ".write": "(auth != null && auth.token.email === 'tylerkim1215@gmail.com')",
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      }
    },
    "$other": {
      ".validate": false
    }
  }
}
